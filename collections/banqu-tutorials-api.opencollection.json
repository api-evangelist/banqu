{
  "opencollection": "1.0.0",
  "info": {
    "name": "BanQu Tutorials API",
    "version": "3.3.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tutorials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /tutorials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://banqu.app:443/api/v1/tutorials",
            "params": [
              {
                "name": "invalidate",
                "value": "",
                "type": "query",
                "description": "Passing any value will invalidate internal cache. Fresh data will be requested from tutorials definitions source."
              }
            ]
          },
          "docs": "List tutorials"
        }
      ]
    }
  ],
  "bundled": true
}