        },
        {
          "info": {
            "name": "POST /transactions/{transactionId}/finalize",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://banqu.app:443/api/v1/transactions/:transactionId/finalize",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              }
