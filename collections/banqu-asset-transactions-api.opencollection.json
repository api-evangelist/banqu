          "info": {
            "name": "GET /transactions/{transactionId}/history/schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://banqu.app:443/api/v1/transactions/:transactionId/history/schema",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
